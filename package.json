{
  "name": "wa-cloud-kit",
  "version": "0.0.0",
  "description": "Small, typed, stateless client for the Meta WhatsApp Cloud API: template/text/document sends, media upload and webhooks.",
  "license": "MIT",
  "author": "Suresh Kumar Muvvala",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json --noEmit",
    "examples:build": "tsc -p examples/tsconfig.json --noEmit false --outDir examples-dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm build && pnpm typecheck && pnpm typecheck:examples && pnpm lint && pnpm test",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "zod": "4.5.4"
  }
}
